#!/bin/sh
APP_BASE_NAME=${0##*/}
APP_HOME=$(cd "${0%/*}" >/dev/null && pwd)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if command -v java >/dev/null 2>&1; then JAVACMD=java;
elif [ -n "$JAVA_HOME" ]; then JAVACMD="$JAVA_HOME/bin/java";
else echo "Java 21+ erforderlich." >&2; exit 1; fi
exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
